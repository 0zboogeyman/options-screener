# 数据目录（留空使用默认 ./data/parquet）
DATA_ROOT=./data/parquet

# Deribit API 地址
DERIBIT_API_URL=https://www.deribit.com/api/v2

# CORS 白名单（JSON数组格式，生产环境请替换为具体域名）
CORS_ORIGINS=["*"]

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ETL 默认抓取币种
ETL_BASES=["BTC","ETH"]

# API 限流（spread/scan 端点的单IP每分钟请求数）
RATE_LIMIT_PER_MINUTE=10/minute

# 数据过期阈值（小时，超过此值健康检查返回 warning）
DATA_STALE_HOURS=25
