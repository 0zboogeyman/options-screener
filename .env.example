# 数据目录（留空使用默认 ./data/parquet）
DATA_ROOT=/app/data/parquet

# Deribit API 地址
DERIBIT_API_URL=https://www.deribit.com/api/v2

# CORS 白名单（JSON 数组格式）：
#   * IP+端口直连场景留空 []，前后端同源经 Next.js rewrites 转发，无需 CORS
#   * 经 Caddy/Nginx 反代绑定域名时，填 ["https://yourdomain.com"]
#   * 禁止使用 ["*"]，会允许任意源跨域
CORS_ORIGINS=[]

# 日志级别: DEBUG / INFO / WARNING / ERROR
# 注意：DEBUG 模式下 500 响应会回显异常详情，生产环境禁止使用 DEBUG
LOG_LEVEL=INFO

# ETL 默认抓取币种
ETL_BASES=["BTC","ETH"]

# ETL 自调度（容器内 supervisord 托管，时间为 UTC）：
#   * "08:05"        每天 UTC 08:05 跑一次 = 台北/北京时间 16:05（默认）
#   * "@every 6h"    每 6 小时跑一次
#   * "off"          关闭调度，仅首次启动时跑一次
# 台北/北京时间 = UTC + 8，例如想台北 16:05 跑 → 填 08:05
ETL_SCHEDULE=08:05

# API 限流（扫描端点单IP每分钟请求数；前端一次操作会发多个请求，不建议低于 20）
RATE_LIMIT_PER_MINUTE=30/minute

# 是否开放 API 文档端点 /docs /redoc /openapi.json（生产环境保持 false）
API_DOCS_ENABLED=false

# 数据过期阈值（小时，超过此值健康检查返回 warning）
DATA_STALE_HOURS=25

# 对外暴露端口（仅 IP+端口直连场景使用，反代场景忽略）
PUBLIC_PORT=3116

# 手动 ETL 触发口令（页面「更新数据」按钮 / POST /api/etl/run）。
# 配置后请求须带 X-Admin-Token 头匹配；prod（ENV=prod）下未配置则管理端点一律 403。
# 公网部署务必设置，否则访客可随意触发 ETL。
# 注意（审计 SEC-2）：通过 URL ?admin=口令 绑定前端口令会进入浏览器历史、
# Referer 与反代日志，存在泄露风险；生产环境建议改用 HTTP 头（curl -H
# "X-Admin-Token: ..."）或私密通道传递。服务端 uvicorn 已禁用 access log。
ADMIN_TOKEN=

# 运行环境：dev（默认，开箱即用）/ prod。
# 公网部署必须 ENV=prod（未配置 ADMIN_TOKEN 时管理端点 403）。
#ENV=prod

# 受信反向代理白名单（JSON 数组，支持 IP 与 CIDR，如 ["172.16.0.0/12"]）。
# 仅当请求对端命中该列表时才信任 X-Forwarded-For / X-Real-IP 头——
# 反代部署时填写反代 IP，让限流与 geo 识别到真实客户端 IP（直连留空 []）。
#TRUSTED_PROXIES=["127.0.0.1","172.16.0.0/12"]

# Telegram Bot 推送（ETL 定时跑完后自动推每日策略精选 + DVOL 异常警报）。
# 两项都配置才启用；留空静默跳过。Bot 创建：Telegram 找 @BotFather，/newbot 拿 token；
# chat_id 获取：先给 bot 发条消息，再访问
#   https://api.telegram.org/bot<TOKEN>/getUpdates 查看 chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 推送语言：zh-CN（默认）/ zh-TW / en
TELEGRAM_LANG=zh-CN
