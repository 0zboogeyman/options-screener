# 数据目录（留空使用默认 ./data/parquet）
DATA_ROOT=/app/data/parquet

# Deribit API 地址
DERIBIT_API_URL=https://www.deribit.com/api/v2

# CORS 白名单（JSON 数组格式）：
#   * IP+端口直连场景留空 []，前后端同源经 Next.js rewrites 转发，无需 CORS
#   * 经 Caddy/Nginx 反代绑定域名时，填 ["https://yourdomain.com"]
#   * 禁止使用 ["*"]，会允许任意源跨域
CORS_ORIGINS=[]

# 日志级别: DEBUG / INFO / WARNING / ERROR
# 注意：DEBUG 模式下 500 响应会回显异常详情，生产环境禁止使用 DEBUG
LOG_LEVEL=INFO

# ETL 默认抓取币种
ETL_BASES=["BTC","ETH"]

# ETL 自调度（容器内 supervisord 托管，时间为 UTC）：
#   * "08:05"        每天 UTC 08:05 跑一次 = 台北/北京时间 16:05（默认）
#   * "@every 6h"    每 6 小时跑一次
#   * "off"          关闭调度，仅首次启动时跑一次
# 台北/北京时间 = UTC + 8，例如想台北 16:05 跑 → 填 08:05
ETL_SCHEDULE=08:05

# API 限流（扫描端点单IP每分钟请求数；前端一次操作会发多个请求，不建议低于 20）
RATE_LIMIT_PER_MINUTE=30/minute

# 是否开放 API 文档端点 /docs /redoc /openapi.json（生产环境保持 false）
API_DOCS_ENABLED=false

# 数据过期阈值（小时，超过此值健康检查返回 warning）
DATA_STALE_HOURS=25

# 对外暴露端口（仅 IP+端口直连场景使用，反代场景忽略）
PUBLIC_PORT=3116
