# syntax=docker/dockerfile:1.6
# =============================================================================
# Option Scanner - 单容器镜像（自包含项目根）
# -----------------------------------------------------------------------------
# 前端为 Next.js 静态导出（output:export，纯 HTML/JS/CSS），
# 由 FastAPI StaticFiles 同源托管；容器内只有 uvicorn 一个 Web 进程，
# 无 Node.js 运行时。进程托管：supervisord（uvicorn + etl-scheduler）。
#
# 构建上下文即本目录（项目根），所有 COPY 路径均为自引用。
#
# 对外契约：
#   * /            -> uvicorn (FastAPI StaticFiles)  容器端口 8000
#   * /api/*       -> uvicorn (FastAPI 路由)         容器端口 8000
#   * /api/health  -> 健康检查端点
# 首次启动自动 ETL：沿用 backend/entrypoint.sh。
# =============================================================================

# ---- Stage 1: 构建 Next.js 静态导出前端 ---------------------------------
FROM node:20-alpine AS frontend-build
WORKDIR /build
ENV NEXT_TELEMETRY_DISABLED=1
# basePath 默认空，IP:port 根路径即可访问；如需子路径部署，
# 在 docker-compose.yml build.args 注入 NEXT_PUBLIC_BASE_PATH=/your-prefix，
# 同时在 .env 设置 FRONTEND_BASE_PATH=/your-prefix 供 FastAPI 挂载。
ARG NEXT_PUBLIC_BASE_PATH=
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# ---- Stage 2: 构建 Python 后端 venv -------------------------------------
FROM python:3.11-slim AS backend-build
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && /opt/venv/bin/pip install -r /app/requirements.txt

# ---- Stage 3: 合并运行时（无 Node.js） ----------------------------------
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# 运行时系统依赖：
#   * curl       - 健康检查使用
#   * supervisor - 进程管理器（uvicorn + etl-scheduler）
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates supervisor \
    && rm -rf /var/lib/apt/lists/*

# 进程共用的非 root 用户。
RUN groupadd -r appuser && useradd -r -g appuser -d /app -s /sbin/nologin appuser

# 后端：venv + 应用包 + ETL 脚本
COPY --from=backend-build /opt/venv /opt/venv
COPY backend/app /app/app
COPY backend/scripts /app/scripts

# 前端：静态导出产物（含 _next/static 与 public 资源），FastAPI 直接托管
COPY --from=frontend-build --chown=appuser:appuser /build/out /app/frontend/out

# 保留后端入口（数据目录为空时自动 ETL）
COPY backend/entrypoint.sh /entrypoint.sh
# 确保 LF 行尾，避免 Windows 编辑产生的 CRLF 在 Linux 容器内导致 /entrypoint.sh: not found
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# 进程管理器配置
COPY supervisord.conf /etc/supervisor/supervisord.conf
RUN sed -i 's/\r$//' /etc/supervisor/supervisord.conf

RUN mkdir -p /app/data && chown -R appuser:appuser /app /app/frontend
USER appuser
WORKDIR /app

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
CMD ["supervisord", "-c", "/etc/supervisor/supervisord.conf", "-n"]
